+++ b/src/api/include/projectM-4/render_opengl.h
@@ -51,6 +51,28 @@ PROJECTM_EXPORT void projectm_opengl_render_frame(projectm_handle instance);
  */
 PROJECTM_EXPORT void projectm_opengl_render_frame_fbo(projectm_handle instance, uint32_t framebuffer_object_id);
 
+/**
+ * @brief Points in a preset's frame where a caller's texture is drawn. Added by the Govtech Visualizer patch set.
+ */
+typedef enum
+{
+    PROJECTM_LAYER_FEEDBACK = 0,         //!< Into the previous frame, before the warp: the warp distorts it.
+    PROJECTM_LAYER_BEFORE_COMPOSITE = 1, //!< After warp, waves and shapes, before the composite shader (not drawn yet).
+} projectm_layer;
+
+/**
+ * @brief Sets the texture drawn at one layer of every frame, alpha-blended over what's there.
+ *
+ * The caller prepares the texture completely (colour adjustments, masks, opacity in straight alpha); projectM
+ * only blends it in. The setting persists across preset loads.
+ *
+ * @param instance The projectM instance handle.
+ * @param layer Where it's drawn.
+ * @param texture A GL_TEXTURE_2D in bottom-up (OpenGL) orientation with straight alpha, owned by the caller and
+ *                valid in this instance's GL context (share group), or 0 to clear the layer.
+ */
+PROJECTM_EXPORT void projectm_set_layer_texture(projectm_handle instance, projectm_layer layer, uint32_t texture);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
