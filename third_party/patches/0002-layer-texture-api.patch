+++ b/src/libprojectM/Renderer/LayerBlend.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "projectM-opengl.h"
+
+namespace libprojectM {
+namespace Renderer {
+
+/**
+ * @brief Caller-owned textures drawn into a preset's frame at fixed points ("layers").
+ *
+ * Added by the Govtech Visualizer patch set. The caller prepares each texture completely (colour and straight
+ * alpha); projectM only alpha-blends it in.
+ */
+struct LayerTextures
+{
+    GLuint feedback{0};        //!< Into the previous frame, before the warp. 0: none.
+    GLuint beforeComposite{0}; //!< After warp, waves and shapes, before the composite shader. 0: none. Stored only.
+};
+
+/**
+ * @brief Alpha-blends a texture into the currently bound framebuffer, keeping the destination's alpha.
+ *
+ * Owns its GL program and VAO; one per projectM instance (created on its GL context).
+ */
+class LayerBlend
+{
+public:
+    LayerBlend();
+    ~LayerBlend();
+
+    LayerBlend(const LayerBlend&) = delete;
+    auto operator=(const LayerBlend&) -> LayerBlend& = delete;
+
+    /**
+     * @brief Blends `texture` (GL_TEXTURE_2D, bottom-up, straight alpha) over the bound framebuffer.
+     * Restores the GL state it changes.
+     */
+    void Draw(GLuint texture);
+
+private:
+    GLuint m_program{0};
+    GLuint m_vao{0};
+    GLint m_textureLocation{-1};
+};
+
+} // namespace Renderer
+} // namespace libprojectM
