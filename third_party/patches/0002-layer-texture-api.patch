@@ -102,6 +102,13 @@ void MilkdropPreset::RenderFrame(const libprojectM::Audio::FrameAudioData& audio
         m_motionVectors.Draw(m_perFrameContext, m_motionVectorUVMap->Texture());
     }
 
+    // Blend the caller's feedback layer into the previous frame while it's still bound, so the warp
+    // below distorts it like the preset's own image.
+    if (m_layerBlend != nullptr && m_layers.feedback != 0)
+    {
+        m_layerBlend->Draw(m_layers.feedback);
+    }
+
     // y-flip the previous frame and assign the flipped texture as "main"
     m_flipTexture.Draw(m_framebuffer.GetColorAttachmentTexture(m_previousFrameBuffer, 0), nullptr, true, false);
     m_state.mainTexture = m_flipTexture.Texture();
@@ -169,6 +176,12 @@ void MilkdropPreset::RenderFrame(const libprojectM::Audio::FrameAudioData& audio
     m_isFirstFrame = false;
 }
 
+void MilkdropPreset::SetLayers(const Renderer::LayerTextures& layers, Renderer::LayerBlend* blend)
+{
+    m_layers = layers;
+    m_layerBlend = blend;
+}
