+void ProjectM::SetLayerTexture(int layer, uint32_t texture)
+{
+    switch (layer)
+    {
+        case PROJECTM_LAYER_FEEDBACK:
+            m_layers.feedback = static_cast<GLuint>(texture);
+            break;
+        case PROJECTM_LAYER_BEFORE_COMPOSITE:
+            m_layers.beforeComposite = static_cast<GLuint>(texture);
+            break;
+        default:
+            break;
+    }
+}
