@@ -51,6 +51,32 @@ PROJECTM_EXPORT void projectm_opengl_render_frame(projectm_handle instance);
  */
 PROJECTM_EXPORT void projectm_opengl_render_frame_fbo(projectm_handle instance, uint32_t framebuffer_object_id);
 
+/**
+ * @brief Sets an external texture that is blended into the preset's feedback buffer before warping.
+ *
+ * The preset's warp then distorts the external image (e.g. live video) like its own. The setting persists
+ * across preset loads. Added by the Govtech Visualizer patch set.
+ *
+ * @param instance The projectM instance handle.
+ * @param texture A GL_TEXTURE_2D in bottom-up (OpenGL) orientation, owned by the caller and valid in this
+ *                instance's GL context (share group), or 0 to disable.
+ */
+PROJECTM_EXPORT void projectm_set_feedback_texture(projectm_handle instance, uint32_t texture);
+
+/**
+ * @brief Sets how strongly the feedback texture is blended in.
+ * @param instance The projectM instance handle.
+ * @param mix Blend amount, 0..1 (default 1).
+ */
+PROJECTM_EXPORT void projectm_set_feedback_mix(projectm_handle instance, float mix);
+
+/**
+ * @brief Sets the luma gate: feedback texture pixels darker than this are transparent.
+ * @param instance The projectM instance handle.
+ * @param luma_min Threshold, 0..1 (default 0: everything blends).
+ */
+PROJECTM_EXPORT void projectm_set_feedback_luma_gate(projectm_handle instance, float luma_min);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
