--- /dev/null
+++ b/src/libprojectM/Renderer/FeedbackBlend.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "projectM-opengl.h"
+
+namespace libprojectM {
+namespace Renderer {
+
+/**
+ * @brief External texture to blend into a preset's feedback (previous frame) buffer before warping.
+ *
+ * Added by the Govtech Visualizer patch set: the preset's warp then distorts the external image (e.g. live
+ * video) instead of it being drawn on top.
+ */
+struct FeedbackSettings
+{
+    GLuint texture{0};   //!< GL_TEXTURE_2D in bottom-up (GL) orientation, owned by the caller. 0 disables blending.
+    float mix{1.0f};     //!< Blend amount, 0..1.
+    float lumaMin{0.0f}; //!< Pixels darker than this (0..1) are transparent.
+};
+
+/**
+ * @brief Draws a FeedbackSettings texture into the currently bound framebuffer with alpha blending.
+ *
+ * Owns its GL program and VAO; one instance per projectM instance (created on its GL context).
+ */
+class FeedbackBlend
+{
+public:
+    FeedbackBlend();
+    ~FeedbackBlend();
+
+    FeedbackBlend(const FeedbackBlend&) = delete;
+    auto operator=(const FeedbackBlend&) -> FeedbackBlend& = delete;
+
+    /**
+     * @brief Blends settings.texture into the bound framebuffer. Restores the GL state it changes.
+     */
+    void Draw(const FeedbackSettings& settings);
+
+private:
+    GLuint m_program{0};
+    GLuint m_vao{0};
+    GLint m_textureLocation{-1};
+    GLint m_mixLocation{-1};
+    GLint m_lumaMinLocation{-1};
+};
+
+} // namespace Renderer
+} // namespace libprojectM
