+auto TextureManager::FindLoadedTexture(const std::string& name) const -> std::shared_ptr<Texture>
+{
+    // Loaded image files are stored under their lower-case base name.
+    const auto it = m_textures.find(Utils::ToLower(name));
+    if (it == m_textures.end() || it->second == m_placeholderTexture || !it->second->IsUserTexture())
+    {
+        return {};
+    }
+    return it->second;
+}
