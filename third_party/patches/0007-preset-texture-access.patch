+++ b/src/libprojectM/ProjectMCWrapper.cpp
@@ -182,6 +182,34 @@ void projectm_set_layer_texture(projectm_handle instance, projectm_layer layer,
     handle_to_instance(instance)->SetLayerTexture(static_cast<int>(layer), texture);
 }
 
+bool projectm_get_preset_texture(projectm_handle instance, const char* name, uint32_t* texture, int* width, int* height)
+{
+    if (name == nullptr)
+    {
+        return false;
+    }
+    uint32_t id{0};
+    int w{0};
+    int h{0};
+    if (!handle_to_instance(instance)->GetPresetTexture(name, id, w, h))
+    {
+        return false;
+    }
+    if (texture != nullptr)
+    {
+        *texture = id;
+    }
+    if (width != nullptr)
+    {
+        *width = w;
+    }
+    if (height != nullptr)
+    {
+        *height = h;
+    }
+    return true;
+}
