--- a/src/libprojectM/ProjectM.cpp
+++ b/src/libprojectM/ProjectM.cpp
@@ -201,6 +201,23 @@ void ProjectM::RenderFrame(uint32_t targetFramebufferObject /*= 0*/)
     m_previousFrameVolume = audioData.vol;
 }
 
+auto ProjectM::GetPresetTexture(const std::string& name, uint32_t& texture, int& width, int& height) const -> bool
+{
+    if (!m_textureManager)
+    {
+        return false;
+    }
+    const auto found = m_textureManager->FindLoadedTexture(name);
+    if (!found || found->Empty())
+    {
+        return false;
+    }
+    texture = found->TextureID();
+    width = found->Width();
+    height = found->Height();
+    return true;
+}
