@@ -73,6 +73,25 @@ typedef enum
  */
 PROJECTM_EXPORT void projectm_set_layer_texture(projectm_handle instance, projectm_layer layer, uint32_t texture);
 
+/**
+ * @brief Finds an image texture the loaded preset samples, so the caller can draw into it.
+ *
+ * The preset's shaders look textures up once, when the preset loads, and bind the same GL texture every frame.
+ * Drawing into this texture (it's color-renderable RGBA) therefore changes what the preset sees from the next
+ * frame on, without reloading anything. projectM keeps owning it; it stays valid until another preset loads or
+ * the instance is destroyed. Its size is the image file's, which the preset sees as texsize_<name>.
+ * Added by the Govtech Visualizer patch set.
+ *
+ * @param instance The projectM instance handle.
+ * @param name The texture's name as in sampler_<name>, without the XY_ wrap/filter prefix; case-insensitive.
+ * @param texture Receives the GL_TEXTURE_2D id (image rows top first, as loaded from the file).
+ * @param width Receives the width in pixels.
+ * @param height Receives the height in pixels.
+ * @return false if the preset doesn't use that image or it couldn't be found (it samples a placeholder).
+ */
+PROJECTM_EXPORT bool projectm_get_preset_texture(projectm_handle instance, const char* name, uint32_t* texture,
+                                                 int* width, int* height);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
diff --git a/src/libprojectM/ProjectM.cpp b/src/libprojectM/ProjectM.cpp
