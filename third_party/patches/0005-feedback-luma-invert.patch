From 86298f2e69eade49e758bd33a5ae812440866e84 Mon Sep 17 00:00:00 2001
From: kurtvan <kurtv7348@gmail.com>
Date: Wed, 28 Oct 2026 21:48:31 -0400
Subject: [PATCH] Invertible luma gate for the feedback texture

Adds projectm_set_feedback_luma_invert. Inverted, the gate keeps the
pixels darker than the threshold instead of the brighter ones, e.g. to
blend only a video's dark subject over a bright background.
---
 src/api/include/projectM-4/render_opengl.h | 7 +++++++
 src/libprojectM/ProjectM.cpp               | 5 +++++
 src/libprojectM/ProjectM.hpp               | 1 +
 src/libprojectM/ProjectMCWrapper.cpp       | 5 +++++
 src/libprojectM/Renderer/FeedbackBlend.cpp | 5 +++++
 src/libprojectM/Renderer/FeedbackBlend.hpp | 2 ++
 6 files changed, 25 insertions(+)

diff --git a/src/api/include/projectM-4/render_opengl.h b/src/api/include/projectM-4/render_opengl.h
index a18105505..7daadea6c 100644
--- a/src/api/include/projectM-4/render_opengl.h
+++ b/src/api/include/projectM-4/render_opengl.h
@@ -92,6 +92,13 @@ PROJECTM_EXPORT void projectm_set_feedback_contrast(projectm_handle instance, fl
  */
 PROJECTM_EXPORT void projectm_set_feedback_saturation(projectm_handle instance, float saturation);
 
+/**
+ * @brief Inverts the luma gate: pixels brighter than the threshold become transparent instead of darker ones.
+ * @param instance The projectM instance handle.
+ * @param invert false = keep the bright parts (default), true = keep the dark parts.
+ */
+PROJECTM_EXPORT void projectm_set_feedback_luma_invert(projectm_handle instance, bool invert);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
diff --git a/src/libprojectM/ProjectM.cpp b/src/libprojectM/ProjectM.cpp
index 61c27ab90..92744ef7b 100644
--- a/src/libprojectM/ProjectM.cpp
+++ b/src/libprojectM/ProjectM.cpp
@@ -226,6 +226,11 @@ void ProjectM::SetFeedbackSaturation(float saturation)
     m_feedback.saturation = std::max(0.0f, std::min(4.0f, saturation));
 }
 
+void ProjectM::SetFeedbackLumaInvert(bool invert)
+{
+    m_feedback.lumaInvert = invert;
+}
+
 void ProjectM::Initialize()
 {
     /** Initialise start time */
diff --git a/src/libprojectM/ProjectM.hpp b/src/libprojectM/ProjectM.hpp
index 58ba5b060..2f8fd917f 100644
--- a/src/libprojectM/ProjectM.hpp
+++ b/src/libprojectM/ProjectM.hpp
@@ -117,6 +117,7 @@ public:
     void SetFeedbackLumaGate(float lumaMin);
     void SetFeedbackContrast(float contrast);
     void SetFeedbackSaturation(float saturation);
+    void SetFeedbackLumaInvert(bool invert);
 
     void SetBeatSensitivity(float sensitivity);
 
diff --git a/src/libprojectM/ProjectMCWrapper.cpp b/src/libprojectM/ProjectMCWrapper.cpp
index d31bc38da..aec64330e 100644
--- a/src/libprojectM/ProjectMCWrapper.cpp
+++ b/src/libprojectM/ProjectMCWrapper.cpp
@@ -202,6 +202,11 @@ void projectm_set_feedback_saturation(projectm_handle instance, float saturation
     handle_to_instance(instance)->SetFeedbackSaturation(saturation);
 }
 
+void projectm_set_feedback_luma_invert(projectm_handle instance, bool invert)
+{
+    handle_to_instance(instance)->SetFeedbackLumaInvert(invert);
+}
+
 void projectm_set_beat_sensitivity(projectm_handle instance, float sensitivity)
 {
     auto projectMInstance = handle_to_instance(instance);
diff --git a/src/libprojectM/Renderer/FeedbackBlend.cpp b/src/libprojectM/Renderer/FeedbackBlend.cpp
index 473d89e5e..4817c2756 100644
--- a/src/libprojectM/Renderer/FeedbackBlend.cpp
+++ b/src/libprojectM/Renderer/FeedbackBlend.cpp
@@ -24,6 +24,7 @@ uniform float uMix;
 uniform float uLumaMin;
 uniform float uContrast;
 uniform float uSaturation;
+uniform bool uLumaInvert;
 in vec2 vUv;
 out vec4 fragColor;
 void main()
@@ -35,6 +36,8 @@ void main()
     color = clamp(color, 0.0, 1.0);
     float luma = dot(color, lumaWeights);
     float gate = smoothstep(uLumaMin - 0.05, uLumaMin + 0.05, luma);
+    if (uLumaInvert)
+        gate = 1.0 - gate;
     fragColor = vec4(color, uMix * gate);
 }
 )GLSL";
@@ -90,6 +93,7 @@ FeedbackBlend::FeedbackBlend()
     m_lumaMinLocation = glGetUniformLocation(m_program, "uLumaMin");
     m_contrastLocation = glGetUniformLocation(m_program, "uContrast");
     m_saturationLocation = glGetUniformLocation(m_program, "uSaturation");
+    m_lumaInvertLocation = glGetUniformLocation(m_program, "uLumaInvert");
     glGenVertexArrays(1, &m_vao);
 }
 
@@ -137,6 +141,7 @@ void FeedbackBlend::Draw(const FeedbackSettings& settings)
     glUniform1f(m_lumaMinLocation, settings.lumaMin);
     glUniform1f(m_contrastLocation, settings.contrast);
     glUniform1f(m_saturationLocation, settings.saturation);
+    glUniform1i(m_lumaInvertLocation, settings.lumaInvert ? 1 : 0);
 
     glActiveTexture(GL_TEXTURE0);
     GLint previousTexture = 0;
diff --git a/src/libprojectM/Renderer/FeedbackBlend.hpp b/src/libprojectM/Renderer/FeedbackBlend.hpp
index 496e9e059..704f4583f 100644
--- a/src/libprojectM/Renderer/FeedbackBlend.hpp
+++ b/src/libprojectM/Renderer/FeedbackBlend.hpp
@@ -18,6 +18,7 @@ struct FeedbackSettings
     float lumaMin{0.0f}; //!< Pixels darker than this (0..1) are transparent.
     float contrast{1.0f};   //!< 1 = unchanged, 0 = flat grey, ~50+ = hard black/white split at mid-grey. Before the luma gate.
     float saturation{1.0f}; //!< 1 = unchanged, 0 = greyscale, 2 = doubled.
+    bool lumaInvert{false}; //!< Pixels brighter than lumaMin are transparent instead.
 };
 
 /**
@@ -47,6 +48,7 @@ private:
     GLint m_lumaMinLocation{-1};
     GLint m_contrastLocation{-1};
     GLint m_saturationLocation{-1};
+    GLint m_lumaInvertLocation{-1};
 };
 
 } // namespace Renderer
