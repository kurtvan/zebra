\ No newline at end of file
+}
+namespace libprojectM {
+namespace Spike {
+
+auto Registry() -> std::map<std::string, Entry>&
+{
+    thread_local std::map<std::string, Entry> registry;
+    return registry;
+}
+
+} // namespace Spike
+} // namespace libprojectM
+
+/// Spike-only: writes "name ms count" lines for the calling thread into buffer and resets the counters.
+extern "C" PROJECTM_EXPORT size_t projectm_spike_timings(char* buffer, size_t size)
+{
+    std::string out;
+    for (const auto& [name, entry] : libprojectM::Spike::Registry())
+    {
+        char line[160];
+        std::snprintf(line, sizeof(line), "%s %.3f %d\n", name.c_str(), entry.milliseconds, entry.count);
+        out += line;
+    }
+    libprojectM::Spike::Registry().clear();
+    if (buffer != nullptr && size > 0)
+    {
+        std::snprintf(buffer, size, "%s", out.c_str());
+    }
+    return out.size();
+}
