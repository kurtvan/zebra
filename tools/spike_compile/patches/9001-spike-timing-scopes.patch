diff --git a/src/libprojectM/SpikeTiming.hpp b/src/libprojectM/SpikeTiming.hpp
new file mode 100644
index 000000000..805867a6e
--- /dev/null
+++ b/src/libprojectM/SpikeTiming.hpp
@@ -0,0 +1,46 @@
+#pragma once
+
+// Spike-only instrumentation (Govtech Visualizer milestone 1). Never part of the shipping patch set.
+
+#include <chrono>
+#include <map>
+#include <string>
+
+namespace libprojectM {
+namespace Spike {
+
+struct Entry
+{
+    double milliseconds{0.0};
+    int count{0};
+};
+
+auto Registry() -> std::map<std::string, Entry>&;
+
+class Scope
+{
+public:
+    explicit Scope(const char* name)
+        : m_name(name)
+        , m_start(std::chrono::steady_clock::now())
+    {
+    }
+
+    ~Scope()
+    {
+        auto& entry = Registry()[m_name];
+        entry.milliseconds += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - m_start).count();
+        entry.count++;
+    }
+
+private:
+    const char* m_name;
+    std::chrono::steady_clock::time_point m_start;
+};
+
+} // namespace Spike
+} // namespace libprojectM
+
+#define GV_SPIKE_CONCAT_INNER(a, b) a##b
+#define GV_SPIKE_CONCAT(a, b) GV_SPIKE_CONCAT_INNER(a, b)
+#define GV_SPIKE_SCOPE(name) ::libprojectM::Spike::Scope GV_SPIKE_CONCAT(gvSpikeScope, __LINE__)(name)
